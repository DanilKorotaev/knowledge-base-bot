# Скопируйте в корневой `.env` рядом с docker-compose или задайте в CI.
# Значения — плейсхолдеры; реальные секреты не коммитить.

# --- Обязательно для защищённых маршрутов /api/* (кроме /health и опционально /api/auth/token)
KB_APP_API_TOKEN=

# Пользователь API в БД (telegram_id synthetic)
KB_APP_API_TELEGRAM_ID=9000000009000001

# Порт публикации (см. docker-compose)
KB_APP_API_PORT=8091

# --- Опционально: выдача того же Bearer через POST /api/auth/token
# KB_APP_API_TOKEN_ENDPOINT_ENABLED=true
# Секрет для тела запроса (см. kb_app_api/routes/auth.py)
# KB_APP_API_TOKEN_ISSUE_SECRET=

# --- БД (как у бота)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=knowledge_base_bot
# DB_USER=postgres
# DB_PASSWORD=

# --- База знаний и ключи (как у бота)
# LOCAL_KB_PATH=/var/knowledge-base-bot/kb
# CURSOR_API_KEY=
# OPENAI_API_KEY=
