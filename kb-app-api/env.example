# Скопируйте в корневой `.env` рядом с docker-compose или задайте в CI.
# Значения — плейсхолдеры; реальные секреты не коммитить.

# --- Обязательно для защищённых маршрутов /api/* (кроме /health и опционально /api/auth/token)
KB_APP_API_TOKEN=

# Пользователь iOS-приложения в БД (реальный telegram_id владельца)
KB_APP_API_TELEGRAM_ID=

# Отдельный пользователь для E2E (заголовок X-KB-App-E2E: 1)
KB_APP_API_TEST_TELEGRAM_ID=9000000009000001

# При ACCESS_MODE=restricted пользователь должен иметь is_allowed=true (выдать через бота).
# Только для отладки:
# KB_APP_API_BYPASS_ACCESS_CHECK=true

# Порт публикации (см. docker-compose)
KB_APP_API_PORT=8091

# Uvicorn workers на хосте (scripts/start-kb-app-api-host.sh).
# 2 — параллельные долгие запросы Cursor + отзывчивый список сессий; 1 только для отладки.
# KB_APP_API_WORKERS=2

# --- Опционально: выдача того же Bearer через POST /api/auth/token
# KB_APP_API_TOKEN_ENDPOINT_ENABLED=true
# Секрет для тела запроса (см. kb_app_api/routes/auth.py)
# KB_APP_API_TOKEN_ISSUE_SECRET=

# --- БД (как у бота)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=knowledge_base_bot
# DB_USER=postgres
# DB_PASSWORD=

# --- База знаний и ключи (как у бота)
# LOCAL_KB_PATH=/var/knowledge-base-bot/kb
# CURSOR_API_KEY=
# OPENAI_API_KEY=

# --- APNs (push о готовом ответе в чате)
# APNS_KEY_ID=8H282799Z5
# APNS_TEAM_ID=66C9VGAZR5
# APNS_AUTH_KEY_PATH=/Users/danilkorotaev/Documents/AuthKey_8H282799Z5.p8
