# Скопируйте в корневой `.env` рядом с docker-compose или задайте в CI.
# Значения — плейсхолдеры; реальные секреты не коммитить.

# --- Обязательно для защищённых маршрутов /api/* (кроме /health, /metrics и опционально /api/auth/token)
# GET /metrics — Prometheus text (без auth), как /health
KB_APP_API_TOKEN=

# Пользователь iOS-приложения в БД (реальный telegram_id владельца)
KB_APP_API_TELEGRAM_ID=

# Отдельный пользователь для E2E (заголовок X-KB-App-E2E: 1)
KB_APP_API_TEST_TELEGRAM_ID=9000000009000001

# При ACCESS_MODE=restricted пользователь должен иметь is_allowed=true (выдать через бота).
# Только для отладки:
# KB_APP_API_BYPASS_ACCESS_CHECK=true

# Порт публикации (см. docker-compose)
KB_APP_API_PORT=8091

# Uvicorn workers на хосте (scripts/start-kb-app-api-host.sh).
# Prefer KB_APP_QUERY_JOBS_ENABLED=true + query worker (Cursor вне uvicorn).
# KB_APP_API_WORKERS=2

# Background Cursor jobs (separate launchd process). SSE still streams via query_job_events.
# KB_APP_QUERY_JOBS_ENABLED=true
# MAX_CONCURRENT_QUERY_JOBS=2
# QUERY_JOB_EVENT_POLL_MS=100

# --- Опционально: выдача того же Bearer через POST /api/auth/token
# KB_APP_API_TOKEN_ENDPOINT_ENABLED=true
# Секрет для тела запроса (см. kb_app_api/routes/auth.py)
# KB_APP_API_TOKEN_ISSUE_SECRET=

# Public read-only chat share links (HTML at /share/{token}, JSON at /api/share/{token})
# KB_APP_PUBLIC_BASE_URL=https://kb-api.example.com
# KB_APP_SHARE_DEFAULT_TTL_DAYS=30

# --- Multi-user auth / Nextcloud provision
# KB_APP_JWT_SECRET=  # required in prod (falls back to KB_APP_API_TOKEN in tests)
# KB_APP_OPEN_SIGNUP=true
# KB_APP_NC_PROVISION_ENABLED=true
# KB_APP_NC_PROVISION_TIMEOUT_SEC=5
# KB_APP_DEFAULT_QUOTA=5 GB
# KB_APP_DEFAULT_KB_FOLDER=/
# Fernet key or passphrase for encrypting per-user NC App Passwords at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, derived from KB_APP_JWT_SECRET (ok for staging).
# KB_NC_TOKEN_KEY=

# --- БД (как у бота)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=knowledge_base_bot
# DB_USER=postgres
# DB_PASSWORD=

# --- База знаний и ключи (как у бота)
# LOCAL_KB_PATH=/var/knowledge-base-bot/kb
# CURSOR_API_KEY=
# OPENAI_API_KEY=

# --- Лимиты вложений в compose (фото + файлы на одно сообщение; голос отдельно)
# MAX_ATTACHMENTS_PER_MESSAGE=10

# Host allowlist for GET /api/remote-ui?url=… (full URLs live in Actions JSON / agent):
# REMOTE_UI_HOST_ALLOWLIST=127.0.0.1,localhost
# (empty → defaults 127.0.0.1,localhost)
# REMOTE_UI_ALLOWED_SCHEMES=http,https
# REMOTE_UI_TIMEOUT_SEC=12
# REMOTE_UI_MAX_BYTES=524288

# --- APNs (push о готовом ответе в чате)
# APNs (.p8 Auth Key). Не кладите ключ в ~/Documents — launchd-сервис может не иметь доступа (TCC).
# Рекомендуется: absolute path under the bot checkout (…/secrets/AuthKey_XXXX.p8, chmod 600)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_AUTH_KEY_PATH=
# APNS_TOPIC=com.example.KnowledgeBaseApp
# APNS_USE_SANDBOX=false