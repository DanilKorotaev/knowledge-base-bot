{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbapp.coredan.ru/schemas/structured-ui/v1.json",
  "title": "StructuredUIScreenDocumentV1",
  "type": "object",
  "required": ["schema_version", "screen"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "screen": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "node": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "vstack",
            "text",
            "button",
            "checkbox",
            "radio_group",
            "select",
            "text_field",
            "image",
            "link",
            "file",
            "divider"
          ]
        },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "text": { "type": "string", "maxLength": 4000 },
        "label": { "type": "string", "maxLength": 200 },
        "action_id": { "type": "string", "maxLength": 128 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "value": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "maxLength": 4000 },
            {
              "type": "array",
              "items": { "type": "string", "maxLength": 128 },
              "maxItems": 32
            }
          ]
        },
        "placeholder": { "type": "string", "maxLength": 200 },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" },
          "minItems": 1,
          "maxItems": 32
        },
        "multi": { "type": "boolean" },
        "submit": { "type": "boolean" },
        "url": { "type": "string", "maxLength": 2000 },
        "download_url": { "type": "string", "maxLength": 2000 },
        "file_name": { "type": "string", "maxLength": 260 },
        "file_size": { "type": "integer", "minimum": 0 },
        "alt": { "type": "string", "maxLength": 500 },
        "content_mode": { "type": "string", "enum": ["fit", "fill"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "type": { "const": "button" } } },
          "then": { "required": ["label", "action_id"] }
        },
        {
          "if": { "properties": { "type": { "const": "checkbox" } } },
          "then": { "required": ["label"] }
        },
        {
          "if": { "properties": { "type": { "const": "radio_group" } } },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "link" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "type": { "const": "file" } } },
          "then": { "required": ["download_url"] }
        }
      ]
    }
  }
}
