# ============================================
# Telegram Knowledge Base Bot - Environment Variables
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ============================================
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# ============================================

# Telegram Bot Token
# Получите у @BotFather в Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# AI API Key (один из двух обязателен)
# Cursor API Key (рекомендуется)
# Получите на https://cursor.com/settings → Integrations → User API Keys
CURSOR_API_KEY=your_cursor_api_key_here

# ИЛИ OpenAI API Key
# Получите на https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# БАЗА ДАННЫХ (PostgreSQL для Docker)
# ============================================

# Тип базы данных: postgresql или sqlite
DB_TYPE=postgresql

# PostgreSQL настройки (для Docker используйте имя сервиса из docker-compose.yml)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=knowledge_base_bot
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# SQLite (только для локальной разработки без Docker)
# DB_TYPE=sqlite
# DB_FILE=bot.db

# ============================================
# NEXTCLOUD (для синхронизации базы знаний)
# ============================================

# URL вашего NextCloud сервера
NEXTCLOUD_URL=https://your-nextcloud.com

# Учетные данные пользователя бота в NextCloud
# Создайте отдельного пользователя и App Password (см. docs/SETUP_NEXTCLOUD.md)
NEXTCLOUD_BOT_USERNAME=telegram_knowledge_bot
NEXTCLOUD_BOT_PASSWORD=your_nextcloud_app_password_here

# Путь к базе знаний в NextCloud
# По умолчанию: /KnowledgeBase
NEXTCLOUD_KNOWLEDGE_BASE_PATH=/KnowledgeBase

# Включить синхронизацию с NextCloud
# true - включено, false - выключено
ENABLE_SYNC=true

# Автоматическая синхронизация (периодическая)
# true - включено, false - выключено
AUTO_SYNC=true

# Интервал синхронизации в секундах (по умолчанию 300 = 5 минут)
SYNC_INTERVAL=300

# ============================================
# ЛОКАЛЬНАЯ БАЗА ЗНАНИЙ
# ============================================

# Путь к локальной копии базы знаний
# Для Docker: путь внутри контейнера (монтируется через volumes в docker-compose.yml)
# По умолчанию: /var/knowledge-base-bot/kb
LOCAL_KB_PATH=/var/knowledge-base-bot/kb

# ============================================
# AI НАСТРОЙКИ
# ============================================

# Модель для Cursor CLI (по умолчанию: gpt-4o)
CURSOR_MODEL=gpt-4o

# ============================================
# НАСТРОЙКИ БОТА
# ============================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Максимальное количество сообщений в сессии
MAX_SESSION_MESSAGES=50

# Максимальное количество вложений на сообщение
MAX_ATTACHMENTS_PER_MESSAGE=5

# Отслеживание изменений (для возможности отката)
ENABLE_CHANGE_TRACKING=true

# Таймаут для Cursor CLI в секундах (по умолчанию: 600 = 10 минут)
CURSOR_CLI_TIMEOUT=600

# Путь к системному промпту (опционально)
# Если не указан, используется: Документация/Системный промпт.md из базы знаний
# Можно указать относительный путь от базы знаний или абсолютный путь

# Путь к системному промпту бота (опционально)
# Если не указан, используется: agent/system_prompt.md из проекта
# Можно указать относительный путь от проекта или абсолютный путь
# BOT_SYSTEM_PROMPT_PATH=agent/system_prompt.md

# Путь к системному промпту базы знаний (опционально)
# Если не указан, ищется: Документация/Системный промпт.md в базе знаний
# Можно указать относительный путь от базы знаний или абсолютный путь
# KB_SYSTEM_PROMPT_PATH=Документация/Системный промпт.md

# Путь к .cursorignore файлу (опционально)
# Если не указан, используется: .cursorignore из проекта
# Можно указать относительный путь от проекта или абсолютный путь
# CURSOR_IGNORE_PATH=.cursorignore

# Путь к .cursorignore (опционально)
# Если не указан, используется: .cursorignore из проекта
# Можно указать относительный путь от проекта или абсолютный путь
# CURSOR_IGNORE_PATH=.cursorignore

# ============================================================
# Mini App (Telegram Web App для управления сессиями)
# ============================================================

# URL Mini App (HTTPS обязателен для Telegram Web App)
# При локальной разработке автоматически заполняется скриптом ./scripts/dev_miniapp.sh
# В продакшене: укажите URL вашего развёрнутого Mini App
# Если пустой — кнопка Mini App не отображается в меню бота
MINIAPP_URL=

# Порт Mini App (по умолчанию 8080)
MINIAPP_PORT=8080

# ============================================================
# Стриминг ответов (обновление сообщения в реальном времени)
# ============================================================

# Включить/выключить стриминг (по умолчанию: true)
# Если выключено — ответ отправляется одним блоком после завершения
STREAMING_ENABLED=true

# Минимальный интервал между обновлениями сообщения (секунды)
# Слишком маленькое значение может вызвать Flood control от Telegram
STREAMING_UPDATE_INTERVAL=1.5

# Минимальный размер буфера для обновления (символов)
# Обновление происходит только когда накоплено >= этого количества символов
STREAMING_MIN_BUFFER=100

# ============================================================
# Ссылки на файлы в NextCloud (кликабельные ссылки в уведомлениях)
# ============================================================

# Режим генерации ссылок:
#   share    — публичные share-ссылки (без авторизации, рекомендуется)
#   direct   — прямые ссылки на веб-интерфейс (требуют авторизации)
#   disabled — ссылки отключены (по умолчанию)
NEXTCLOUD_LINK_MODE=share

# URL веб-интерфейса NextCloud (если отличается от NEXTCLOUD_URL)
# Если не указан — используется NEXTCLOUD_URL
# NEXTCLOUD_WEB_URL=https://your-nextcloud.com

# Срок жизни share-ссылок в часах (только для режима share)
# NextCloud автоматически удаляет просроченные ссылки
NEXTCLOUD_SHARE_EXPIRATION_HOURS=24

# --- Постобработка транскрипции (полировка текста) ---
# Включить/выключить полировку транскрипции при нажатии «🎤 Только транскрибировать»
TRANSCRIPTION_POLISH_ENABLED=true
# Модель для полировки (лёгкая и быстрая; в рамках подписки Cursor)
TRANSCRIPTION_POLISH_MODEL=gpt-4o-mini
# Путь к файлу промпта для полировки (по умолчанию agent/transcription_polish_prompt.md)
# Можно указать абсолютный путь или относительный от корня проекта
# TRANSCRIPTION_POLISH_PROMPT_PATH=